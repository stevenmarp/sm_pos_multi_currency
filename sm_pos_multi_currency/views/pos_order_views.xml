<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_pos_form_inherit" model="ir.ui.view">
        <field name="name">pos.order.form.inherit.sm.pos.multi.currency</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_ids']/list/field[@name='amount']" position="after">
                <field name="sm_amount_currency" optional="show"/>
                <field name="sm_currency_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
