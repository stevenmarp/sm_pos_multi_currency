<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sm.pos.multi.currency</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_payment_section']" position="inside">
                <setting id="sm_pos_multi_currency_setting"
                         string="Multi Currency"
                         help="Accept payments in foreign currencies with live conversion on the payment screen">
                    <field name="pos_sm_enable_multi_currency"/>
                    <div class="content-group mt16" invisible="not pos_sm_enable_multi_currency">
                        <field name="pos_sm_currency_ids" widget="many2many_tags"
                               placeholder="Allowed currencies..."/>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
