<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="sm_pos_multi_currency.PaymentScreenButtons"
       t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('payment-buttons')]" position="inside">
            <div t-if="smEnabled" class="sm-mc-panel border rounded-3 p-2 bg-view">
                <div class="fw-bolder mb-1">Select Currency</div>
                <select class="form-select mb-2" t-on-change="smSelectCurrency">
                    <option value="">select currency</option>
                    <t t-foreach="smCurrencies" t-as="cur" t-key="cur.id">
                        <option t-att-value="cur.id" t-esc="cur.name"/>
                    </t>
                </select>
                <div class="fw-bolder mb-1">Currency Conversion</div>
                <div class="border rounded p-2 mb-2 small">
                    <div>
                        1 <t t-esc="pos.currency.name"/> =
                        <t t-if="smSelectedCurrency" t-esc="smFormat(smRate)"/>
                    </div>
                    <div>
                        Total Amount =
                        <t t-if="smSelectedCurrency" t-esc="smFormat(smTotalInCurrency)"/>
                    </div>
                    <div t-if="smSelectedCurrency and smChangeInCurrency gt 0" class="text-success fw-bolder">
                        Change = <t t-esc="smFormat(smChangeInCurrency)"/>
                    </div>
                </div>
                <div class="fw-bolder mb-1">Payment amount in</div>
                <input type="number" class="form-control mb-2" t-model="smState.amountIn"
                       placeholder="0.00" step="any" min="0"/>
                <button class="btn btn-secondary w-100" t-on-click="smUpdateAmount">Update Amount</button>
            </div>
        </xpath>
    </t>

    <t t-name="sm_pos_multi_currency.PaymentScreenPaymentLines"
       t-inherit="point_of_sale.PaymentScreenPaymentLines" t-inherit-mode="extension">
        <xpath expr="//span[hasclass('payment-name')]" position="after">
            <span t-if="line.smForeignLabel" class="text-muted ms-2 fs-4">
                (<t t-esc="line.smForeignLabel"/>)
            </span>
        </xpath>
        <xpath expr="//t[@t-else='']//div[hasclass('payment-infos')]/t[@t-esc='line.payment_method_id.name']" position="after">
            <span t-if="line.smForeignLabel" class="text-muted ms-2 fs-4">
                (<t t-esc="line.smForeignLabel"/>)
            </span>
        </xpath>
    </t>

</templates>
